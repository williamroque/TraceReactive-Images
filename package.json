{
  "name": "@gravitydock/images",
  "version": "1.0.0",
  "description": "Gravity Dock Images package",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --platform=browser --format=iife --global-name=__GravityDock_Package --external:@fxpineau/moc-wasm --loader:.wasm=empty",
    "build:gdpkg": "npm run build && node scripts/build-gdpkg.js",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build -- --watch"
  },
  "devDependencies": {
    "@gravitydock/types": "file:../types",
    "adm-zip": "^0.5.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "fast-png": "^8.0.0",
    "fflate": "^0.8.2",
    "fitsjs-ng": "^1.0.2"
  }
}
